# Local development can use a direct Postgres URL.
# For deployed Supabase, prefer the transaction pooler on port 6543.
# Port 5432 session-pooler URLs still work, but the backend will warn because
# constrained session limits can queue concurrent governance reads.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me
SECRET_KEY=replace-me
ENVIRONMENT=dev
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Client communications draft generation (PM /reports Phase 4)
COMMUNICATIONS_LLM_MODEL=gpt-4o-mini
COMMUNICATIONS_LLM_TIMEOUT_SECONDS=2.5
COMMUNICATIONS_LLM_MAX_TOKENS=350
COMMUNICATIONS_MAX_BODY_WORDS=150
COMMUNICATIONS_INSTRUCTIONS_MAX_CHARS=2000
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# Durable Governance job queue (Phase F)
GOVERNANCE_JOB_POLL_INTERVAL_SECONDS=5
GOVERNANCE_JOB_POLL_BATCH_SIZE=3
GOVERNANCE_JOB_STALE_SECONDS=180
GOVERNANCE_JOB_HEARTBEAT_SECONDS=30
GOVERNANCE_JOB_WORKER_ID=
GOVERNANCE_JOB_EXPORT_DIR=./data/governance-exports
